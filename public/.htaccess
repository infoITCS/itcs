# ============================================================================
# ITCS — Production Apache / Plesk Configuration (.htaccess)
# Strictly enforces HTTPS, www canonical host, 301 redirects, and SPA routing
# ============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --------------------------------------------------------------------------
  # 1. Strictly redirect all HTTP and non-www to https://www.itcs.com.pk (301)
  # --------------------------------------------------------------------------
  # Case A: Non-HTTPS (regardless of www) -> 301 to https://www.itcs.com.pk
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^(.*)$ https://www.itcs.com.pk/$1 [R=301,L]

  # Case B: HTTPS but non-www (e.g. https://itcs.com.pk) -> 301 to https://www.itcs.com.pk
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^[0-9.]+$
  RewriteRule ^(.*)$ https://www.itcs.com.pk/$1 [R=301,L]

  # --------------------------------------------------------------------------
  # 2. Canonical URL Normalization (Strip trailing slashes for non-directories)
  # --------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/+$
  RewriteRule ^ %1 [R=301,L]

  # --------------------------------------------------------------------------
  # 3. Legacy and duplicate path redirects (301 Permanent)
  # --------------------------------------------------------------------------
  RewriteRule ^home/?$                  /                                   [R=301,L]
  RewriteRule ^about/?$                 /about-us                           [R=301,L]
  RewriteRule ^contact-us/?$            /contact                            [R=301,L]
  RewriteRule ^vision-mission/?$        /mission-vision                     [R=301,L]
  RewriteRule ^cyber-security/?$        /cybersecurity                      [R=301,L]
  RewriteRule ^services/cloud/?$        /cloud                              [R=301,L]
  RewriteRule ^services/cloud/(.*)$     /cloud/$1                           [R=301,L]
  RewriteRule ^services/cybersecurity/?$ /cybersecurity                     [R=301,L]
  RewriteRule ^services/cybersecurity/(.*)$ /cybersecurity/$1               [R=301,L]
  RewriteRule ^services/consulting/?$   /consulting                         [R=301,L]
  RewriteRule ^services/enterprise-solutions/?$ /enterprise-solutions     [R=301,L]
  RewriteRule ^services/it-services/?$  /it-services                        [R=301,L]
  RewriteRule ^services/network-solutions/?$ /network-solutions             [R=301,L]
  RewriteRule ^services/network-solutions/(.*)$ /network-solutions/$1       [R=301,L]
  RewriteRule ^services/web-development/?$ /web-development                 [R=301,L]
  RewriteRule ^services/ai/?$           /ai                                 [R=301,L]

  # --------------------------------------------------------------------------
  # 4. SPA Fallback Routing
  # Serve physical files/directories directly; route all other requests to index.html
  # Bypass API and Uploads to preserve backend reverse proxy
  # --------------------------------------------------------------------------
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/uploads/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------------
# 5. Correct MIME Types
# ----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType image/svg+xml              .svg
  AddType font/woff2                 .woff2
  AddType application/json           .json
  AddType application/xml            .xml
  AddType text/plain                 .txt
</IfModule>

# ----------------------------------------------------------------------------
# 6. Gzip & Deflate Compression
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ----------------------------------------------------------------------------
# 7. Browser Caching Headers
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresDefault                        "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
</IfModule>
